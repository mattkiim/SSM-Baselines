+"""Old-Gym API bridge to the exact Safety-Gymnasium velocity-v1 tasks."""
+
+import gym
+import numpy as np
+import safety_gymnasium
+from jaxrl5.wrappers.action_rescale import SymmetricActionWrapper
+
+
+class VelocityEnv:
+    def __init__(self, env_name, seed=0):
+        if env_name not in ('SafetyAntVelocity-v1', 'SafetyHumanoidVelocity-v1'):
+            raise ValueError('Expected Ant or Humanoid velocity-v1')
+        self.env = SymmetricActionWrapper(safety_gymnasium.make(env_name))
+        self._seed = seed
+        ob = self.env.observation_space
+        ac = self.env.action_space
+        self.observation_space = gym.spaces.Box(ob.low, ob.high, dtype=ob.dtype)
+        self.action_space = gym.spaces.Box(ac.low, ac.high, dtype=ac.dtype)
+        self.action_space.seed(seed)
+
+    def reset(self):
+        obs, _ = self.env.reset(seed=self._seed)
+        self._seed = None
+        return obs
+
+    def step(self, action):
+        # PPO uses an unbounded Gaussian; apply valid actions before the
+        # simulator computes both dynamics and action-dependent reward terms.
+        action = np.clip(action, self.action_space.low, self.action_space.high)
+        obs, reward, cost, terminated, truncated, info = self.env.step(action)
+        return obs, reward, bool(terminated or truncated), dict(
+            info, cost=float(cost), **{'TimeLimit.truncated': bool(truncated and not terminated)}
+        )
+
+    def close(self):
+        self.env.close()
